# Kakao (rotated keys only — never the old git-exposed ones; map + share)
NEXT_PUBLIC_KAKAO_JS_KEY=your-rotated-js-key
# Session
SESSION_SECRET=generate-with: openssl rand -hex 32
# Neon Postgres
DATABASE_URL=postgres://...
# Base URL (dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# 운영자(어드민) 세션. openssl rand -hex 32 로 생성 — SESSION_SECRET과 다른 값이어야 한다.
ADMIN_SESSION_SECRET=generate-with: openssl rand -hex 32
# 최초 super_admin 계정 생성용 (scripts/seed-admin.mjs 실행 시에만 필요, 평소엔 비워둠)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Kakao 로그인 (OAuth). Kakao는 REST API 키를 client_id로 쓴다
KAKAO_REST_API_KEY=your-rotated-rest-key
# (선택) 카카오 콘솔에서 client secret을 켠 경우에만
KAKAO_CLIENT_SECRET=
