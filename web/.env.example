# Kakao (rotated keys only — never the old git-exposed ones; map/geocoding only)
NEXT_PUBLIC_KAKAO_JS_KEY=your-rotated-js-key
# Google OAuth (Web application client — NOT the installed-type sheets MCP client)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
# Session
SESSION_SECRET=generate-with: openssl rand -hex 32
# Neon Postgres
DATABASE_URL=postgres://...
# Base URL (dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# DAU/MAU stats. Namespaced id of the admin, e.g. google:1234 or kakao:5678
# /api/stats returns 404 while this is empty.
ADMIN_USER_ID=

# Kakao 로그인 (OAuth). Kakao는 REST API 키를 client_id로 쓴다
KAKAO_REST_API_KEY=your-rotated-rest-key
# (선택) 카카오 콘솔에서 client secret을 켠 경우에만
KAKAO_CLIENT_SECRET=
